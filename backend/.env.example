# For plain local Postgres, DATABASE_URL alone is enough and DIRECT_URL can
# be left equal to it. For a pooled host (e.g. Supabase's pgbouncer pooler),
# DATABASE_URL should point at the pooled port (6543) with ?pgbouncer=true,
# and DIRECT_URL at the direct/session port (5432) — Prisma migrations use
# DIRECT_URL since pgbouncer's transaction mode doesn't support them.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/collab_code_editor"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/collab_code_editor"
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
FRONTEND_URL=http://localhost:5173
